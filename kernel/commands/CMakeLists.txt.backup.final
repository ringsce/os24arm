# ============================================================================
# kernel/commands/CMakeLists.txt - User Commands as LX Executables
# ============================================================================

# Check if LX tools are available
if(CMAKE_CROSSCOMPILING)
    set(LX_TOOLS_DEP lx_host_tools)
else()
    set(LX_TOOLS_DEP lxbuild)
endif()

# Compiler settings for freestanding ARM64 executables
set(CMD_C_FLAGS
        -ffreestanding
        -nostdlib
        -fno-stack-protector
        -fPIC
        -Os
        -mstrict-align
)

set(CMD_LINK_FLAGS
        -nostdlib
        -Wl,--build-id=none
        -Wl,-N
)

# Include directories (properly formatted with -I)
set(CMD_INCLUDES
        "-I${CMAKE_CURRENT_SOURCE_DIR}/../include"
        "-I${CMAKE_SOURCE_DIR}/rexx"
        "-I${CMAKE_SOURCE_DIR}/os2"
)

# Configuration
set(ENTRY_ADDRESS 0x10000)
set(DEFAULT_STACK 65536)      # 64KB
set(LARGE_STACK   131072)     # 128KB

# ── Helper Functions ──────────────────────────────────────────────────────────

# Build a single-file command
function(build_lx_exe EXE_NAME SOURCE_FILE STACK_SIZE)
    string(TOUPPER ${EXE_NAME} TARGET_NAME)

    # Compile
    add_custom_command(
            OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.o
            COMMAND ${CMAKE_C_COMPILER}
            ${CMD_C_FLAGS}
            ${CMD_INCLUDES}
            -c ${CMAKE_CURRENT_SOURCE_DIR}/../src/${SOURCE_FILE}
            -o ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.o
            DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/../src/${SOURCE_FILE}
            COMMENT "Compiling ${SOURCE_FILE} for ${EXE_NAME}.EXE"
            VERBATIM
    )

    # Link
    add_custom_command(
            OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            COMMAND ${CMAKE_C_COMPILER}
            ${CMD_LINK_FLAGS}
            -Wl,-Ttext=${ENTRY_ADDRESS}
            ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.o
            -o ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.o
            COMMENT "Linking ${TARGET_NAME}.elf"
            VERBATIM
    )

    # Extract binary
    add_custom_command(
            OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            COMMAND ${CMAKE_OBJCOPY}
            -O binary
            ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            COMMENT "Extracting binary from ${TARGET_NAME}.elf"
            VERBATIM
    )

    # Create LX executable
    add_custom_command(
            OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${EXE_NAME}.EXE
            COMMAND ${LXBUILD}
            -o ${EXE_NAME}.EXE
            --entry 0
            --stack ${STACK_SIZE}
            ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            DEPENDS ${LX_TOOLS_DEP} ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
            COMMENT "Creating ${EXE_NAME}.EXE"
            VERBATIM
    )

    add_custom_target(${TARGET_NAME}_exe ALL
            DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${EXE_NAME}.EXE
    )

    install(FILES ${CMAKE_CURRENT_BINARY_DIR}/${EXE_NAME}.EXE
            DESTINATION bin)
endfunction()

# Build multi-file command
function(build_lx_exe_multi EXE_NAME STACK_SIZE)
    string(TOUPPER ${EXE_NAME} TARGET_NAME)
    set(SOURCE_FILES ${ARGN})
    set(OBJECT_FILES "")

    # Compile each source file
    foreach(SOURCE_FILE ${SOURCE_FILES})
        get_filename_component(BASE_NAME ${SOURCE_FILE} NAME_WE)
        set(OBJ_FILE ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}_${BASE_NAME}.o)

        add_custom_command(
                OUTPUT ${OBJ_FILE}
                COMMAND ${CMAKE_C_COMPILER}
                ${CMD_C_FLAGS}
                ${CMD_INCLUDES}
                -c ${CMAKE_CURRENT_SOURCE_DIR}/../src/${SOURCE_FILE}
                -o ${OBJ_FILE}
                DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/../src/${SOURCE_FILE}
                COMMENT "Compiling ${SOURCE_FILE}"
                VERBATIM
        )

        list(APPEND OBJECT_FILES ${OBJ_FILE})
    endforeach()

    # Link all objects together
    add_custom_command(
            OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            COMMAND ${CMAKE_C_COMPILER}
            ${CMD_LINK_FLAGS}
            -Wl,-Ttext=${ENTRY_ADDRESS}
            ${OBJECT_FILES}
            -o ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            DEPENDS ${OBJECT_FILES}
            COMMENT "Linking ${TARGET_NAME}.elf"
            VERBATIM
    )

    # Extract binary
    add_custom_command(
            OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            COMMAND ${CMAKE_OBJCOPY}
            -O binary
            ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.elf
            COMMENT "Extracting binary"
            VERBATIM
    )

    # Create LX executable
    add_custom_command(
            OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${EXE_NAME}.EXE
            COMMAND ${LXBUILD}
            -o ${EXE_NAME}.EXE
            --entry 0
            --stack ${STACK_SIZE}
            ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            DEPENDS ${LX_TOOLS_DEP} ${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}.bin
            WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
            COMMENT "Creating ${EXE_NAME}.EXE"
            VERBATIM
    )

    add_custom_target(${TARGET_NAME}_exe ALL
            DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${EXE_NAME}.EXE
    )

    install(FILES ${CMAKE_CURRENT_BINARY_DIR}/${EXE_NAME}.EXE
            DESTINATION bin)
endfunction()

# ══════════════════════════════════════════════════════════════════════════════
# COMMAND EXECUTABLES
# ══════════════════════════════════════════════════════════════════════════════

# BASIC Interpreter: src/basic.c → BAS.EXE
build_lx_exe(BAS basic.c ${LARGE_STACK})

# CLI with filesystem: src/cli.c + src/cli_fs.c → CLI.EXE
build_lx_exe_multi(CLI ${LARGE_STACK}
        cli.c
        cli_fs.c
)

# ══════════════════════════════════════════════════════════════════════════════

add_custom_target(all_commands
        DEPENDS
        BAS_exe
        CLI_exe
        COMMENT "Building all command executables"
)

message(STATUS "")
message(STATUS "═══════════════════════════════════════════════════════════")
message(STATUS "Command Executables Configuration")
message(STATUS "═══════════════════════════════════════════════════════════")
message(STATUS "Include paths:")
message(STATUS "  ${CMAKE_CURRENT_SOURCE_DIR}/../include")
message(STATUS "  ${CMAKE_SOURCE_DIR}/rexx")
message(STATUS "  ${CMAKE_SOURCE_DIR}/os2")
message(STATUS "")
message(STATUS "Commands:")
message(STATUS "  BAS.EXE (basic.c)")
message(STATUS "  CLI.EXE (cli.c + cli_fs.c)")
message(STATUS "═══════════════════════════════════════════════════════════")
message(STATUS "")