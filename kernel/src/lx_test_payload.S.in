/* kernel/src/lx_test_payload.S.in — generated by CMake (configure_file)
 *
 * Embeds a build-time copy of HELLO.EXE into the kernel image so the
 * built-in LX loader (kernel/src/lx_loader.c) can be exercised in QEMU
 * without needing a populated disk image yet. See the RUNTEST command in
 * kernel/src/main.c and the "Embed HELLO.EXE..." block in the top-level
 * CMakeLists.txt, which substitutes @HELLO_EXE_PATH@ below.
 */

.section .rodata
.align 4
.global lx_test_hello_start
lx_test_hello_start:
.incbin "@HELLO_EXE_PATH@"
.global lx_test_hello_end
lx_test_hello_end:
