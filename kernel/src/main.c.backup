#include "os2.h"
#include "keyboard.h"
#include "vfs.h"
#include "blkdev.h"
#include "ifs_loader.h"
#include "../../fs/ext4/ext4.h"

/* Memory heap configuration */
extern uint8_t _bss_end;
#define HEAP_START  ((uintptr_t)&_bss_end + 0x1000u)
#define HEAP_SIZE   (8u * 1024u * 1024u)

extern void mem_init(uintptr_t start, size_t size);
extern void scheduler_init(void);

/* ── UART ────────────────────────────────────────────────────────────────── */

#define UART_BASE    ((volatile ULONG *)0x09000000UL)
#define UART_DR      (UART_BASE + 0x00)
#define UART_FR      (UART_BASE + 0x06)
#define UART_FR_TXFF (1u << 5)
#define UART_FR_RXFE (1u << 4)

static void uart_putc(char c)
{
    while (*UART_FR & UART_FR_TXFF);
    *UART_DR = (ULONG)c;
}

static void uart_puts(const char *s)
{
    while (*s) {
        if (*s == '\n')
            uart_putc('\r');
        uart_putc(*s++);
    }
}

static char uart_getc(void)
{
    while (*UART_FR & UART_FR_RXFE);
    return (char)(*UART_DR & 0xFF);
}

static void uart_puthex(ULONG val)
{
    const char hex[] = "0123456789ABCDEF";
    uart_puts("0x");
    for (int shift = 28; shift >= 0; shift -= 4)
        uart_putc(hex[(val >> shift) & 0xF]);
}

/* ── String utilities ────────────────────────────────────────────────────── */

static int my_strcmp(const char *s1, const char *s2)
{
    while (*s1 && (*s1 == *s2)) {
        s1++;
        s2++;
    }
    return *(unsigned char*)s1 - *(unsigned char*)s2;
}

static int my_strlen(const char *s)
{
    int len = 0;
    while (*s++)
        len++;
    return len;
}

static char* my_strcpy(char *dst, const char *src)
{
    char *ret = dst;
    while ((*dst++ = *src++));
    return ret;
}

static int my_atoi(const char *str)
{
    int result = 0;
    int sign = 1;

    while (*str == ' ' || *str == '\t')
        str++;

    if (*str == '-') {
        sign = -1;
        str++;
    } else if (*str == '+') {
        str++;
    }

    while (*str >= '0' && *str <= '9') {
        result = result * 10 + (*str - '0');
        str++;
    }

    return sign * result;
}

static int str_tokenize(char *str, char **tokens, int max_tokens)
{
    int count = 0;
    char *p = str;

    while (*p && count < max_tokens) {
        while (*p == ' ' || *p == '\t')
            p++;

        if (*p == '\0')
            break;

        tokens[count++] = p;

        while (*p && *p != ' ' && *p != '\t')
            p++;

        if (*p)
            *p++ = '\0';
    }

    return count;
}

static void str_toupper(char *s)
{
    while (*s) {
        if (*s >= 'a' && *s <= 'z')
            *s = *s - 'a' + 'A';
        s++;
    }
}

/* ── BASIC Interpreter ───────────────────────────────────────────────────── */

#define MAX_BASIC_LINES 100
#define MAX_BASIC_VARS  26   /* A-Z */
#define MAX_LINE_LEN    256

typedef struct {
    int line_num;
    char code[MAX_LINE_LEN];
} basic_line_t;

static basic_line_t basic_program[MAX_BASIC_LINES];
static int basic_line_count = 0;
static int basic_vars[MAX_BASIC_VARS];  /* A=0, B=1, ... Z=25 */
static int basic_pc = 0;  /* Program counter */

static void basic_init(void)
{
    basic_line_count = 0;
    basic_pc = 0;
    for (int i = 0; i < MAX_BASIC_VARS; i++)
        basic_vars[i] = 0;
}

static int basic_find_line(int line_num)
{
    for (int i = 0; i < basic_line_count; i++) {
        if (basic_program[i].line_num == line_num)
            return i;
    }
    return -1;
}

static void basic_insert_line(int line_num, const char *code)
{
    /* Remove existing line with same number */
    int idx = basic_find_line(line_num);
    if (idx >= 0) {
        /* Replace existing line */
        my_strcpy(basic_program[idx].code, code);
        return;
    }

    /* Add new line in sorted order */
    if (basic_line_count >= MAX_BASIC_LINES) {
        uart_puts("Error: Program full\r\n");
        return;
    }

    /* Find insertion point */
    int insert_at = basic_line_count;
    for (int i = 0; i < basic_line_count; i++) {
        if (basic_program[i].line_num > line_num) {
            insert_at = i;
            break;
        }
    }

    /* Shift lines down */
    for (int i = basic_line_count; i > insert_at; i--) {
        basic_program[i] = basic_program[i - 1];
    }

    /* Insert new line */
    basic_program[insert_at].line_num = line_num;
    my_strcpy(basic_program[insert_at].code, code);
    basic_line_count++;
}

static int basic_eval_expr(const char *expr)
{
    /* Very simple expression evaluator */
    /* Supports: numbers, variables (A-Z), +, -, *, / */

    const char *p = expr;
    while (*p == ' ') p++;

    /* Check if it's a variable */
    if (*p >= 'A' && *p <= 'Z') {
        return basic_vars[*p - 'A'];
    }

    /* Check if it's a number */
    if (*p >= '0' && *p <= '9' || *p == '-') {
        return my_atoi(p);
    }

    return 0;
}

static void basic_exec_line(const char *line)
{
    char cmd[32];
    const char *p = line;
    int i = 0;

    /* Skip whitespace */
    while (*p == ' ') p++;

    /* Extract command */
    while (*p && *p != ' ' && i < 31) {
        cmd[i++] = *p++;
    }
    cmd[i] = '\0';

    str_toupper(cmd);

    /* Skip whitespace after command */
    while (*p == ' ') p++;

    /* Execute command */
    if (my_strcmp(cmd, "PRINT") == 0) {
        /* PRINT command */
        if (*p == '"') {
            /* String literal */
            p++;
            while (*p && *p != '"') {
                uart_putc(*p++);
            }
            uart_puts("\r\n");
        } else {
            /* Expression */
            int val = basic_eval_expr(p);
            char buf[32];
            int j = 0;
            if (val < 0) {
                uart_putc('-');
                val = -val;
            }
            if (val == 0) {
                uart_putc('0');
            } else {
                while (val > 0) {
                    buf[j++] = '0' + (val % 10);
                    val /= 10;
                }
                for (int k = j - 1; k >= 0; k--)
                    uart_putc(buf[k]);
            }
            uart_puts("\r\n");
        }
    }
    else if (my_strcmp(cmd, "LET") == 0) {
        /* LET var = expr */
        if (*p >= 'A' && *p <= 'Z') {
            int var_idx = *p - 'A';
            p++;
            while (*p == ' ') p++;
            if (*p == '=') {
                p++;
                while (*p == ' ') p++;
                basic_vars[var_idx] = basic_eval_expr(p);
            }
        }
    }
    else if (my_strcmp(cmd, "GOTO") == 0) {
        int line_num = my_atoi(p);
        int idx = basic_find_line(line_num);
        if (idx >= 0) {
            basic_pc = idx - 1;  /* -1 because it will be incremented */
        }
    }
    else if (my_strcmp(cmd, "END") == 0) {
        basic_pc = basic_line_count;  /* Exit program */
    }
    else if (my_strcmp(cmd, "REM") == 0) {
        /* Comment - do nothing */
    }
}

static void cmd_basic(void)
{
    uart_puts("\r\n");
    uart_puts("OS/2 BASIC Interpreter v1.0\r\n");
    uart_puts("Commands: LIST, RUN, NEW, EXIT\r\n");
    uart_puts("\r\n");

    basic_init();

    char buffer[256];
    int pos = 0;

    while (1) {
        uart_puts("BASIC> ");

        /* Read line */
        pos = 0;
        while (1) {
            char c = uart_getc();

            if (c == '\r' || c == '\n') {
                uart_puts("\r\n");
                buffer[pos] = '\0';
                break;
            }
            else if (c == 0x7F || c == 0x08) {
                if (pos > 0) {
                    pos--;
                    uart_putc('\b');
                    uart_putc(' ');
                    uart_putc('\b');
                }
            }
            else if (c >= 32 && c < 127) {
                if (pos < 255) {
                    buffer[pos++] = c;
                    uart_putc(c);
                }
            }
        }

        if (pos == 0)
            continue;

        /* Parse command */
        str_toupper(buffer);

        /* Check for immediate commands */
        if (my_strcmp(buffer, "LIST") == 0) {
            for (int i = 0; i < basic_line_count; i++) {
                char num_buf[16];
                int n = basic_program[i].line_num;
                int j = 0;
                while (n > 0) {
                    num_buf[j++] = '0' + (n % 10);
                    n /= 10;
                }
                for (int k = j - 1; k >= 0; k--)
                    uart_putc(num_buf[k]);
                uart_putc(' ');
                uart_puts(basic_program[i].code);
                uart_puts("\r\n");
            }
        }
        else if (my_strcmp(buffer, "RUN") == 0) {
            basic_pc = 0;
            while (basic_pc < basic_line_count) {
                basic_exec_line(basic_program[basic_pc].code);
                basic_pc++;
            }
        }
        else if (my_strcmp(buffer, "NEW") == 0) {
            basic_init();
            uart_puts("Program cleared\r\n");
        }
        else if (my_strcmp(buffer, "EXIT") == 0) {
            uart_puts("Exiting BASIC...\r\n");
            return;
        }
        else if (buffer[0] >= '0' && buffer[0] <= '9') {
            /* Line number - add to program */
            int line_num = my_atoi(buffer);
            const char *code = buffer;
            while (*code && *code != ' ')
                code++;
            while (*code == ' ')
                code++;
            basic_insert_line(line_num, code);
        }
        else {
            /* Immediate execution */
            basic_exec_line(buffer);
        }
    }
}

/* ── Other Commands (VER, HELP, DIR, etc.) ──────────────────────────────── */

static void cmd_ver(void)
{
    uart_puts("\r\n");
    uart_puts("OS/2 Warp Version 4.52 (ARM64 Edition)\r\n");
    uart_puts("Internal revision: Bare Metal Build\r\n");
    uart_puts("Kernel: 4.52.001\r\n");
    uart_puts("Platform: ARM64 Cortex-A72\r\n");
    uart_puts("Target: QEMU virt machine\r\n");
    uart_puts("\r\n");
}

static void cmd_help(void)
{
    uart_puts("\r\n");
    uart_puts("Available commands:\r\n");
    uart_puts("  VER       - Display OS version\r\n");
    uart_puts("  DIR       - List directory contents\r\n");
    uart_puts("  TYPE      - Display file contents\r\n");
    uart_puts("  ECHO      - Display message\r\n");
    uart_puts("  CLS       - Clear screen\r\n");
    uart_puts("  MEM       - Display memory information\r\n");
    uart_puts("  IFS       - List loaded filesystem drivers\r\n");
    uart_puts("  BASIC     - Start BASIC interpreter\r\n");
    uart_puts("  EXIT      - Exit to idle loop\r\n");
    uart_puts("  HELP      - Display this help\r\n");
    uart_puts("\r\n");
}

static void cmd_dir(int argc, char **argv)
{
    const char *path = (argc > 1) ? argv[1] : ".";

    uart_puts("\r\n Directory of ");
    uart_puts(path);
    uart_puts("\r\n\r\n");

    int dfd = vfs_opendir(path);

    if (dfd < 0) {
        uart_puts("Directory not found or VFS not ready\r\n");
        uart_puts("\r\n");
        uart_puts("Sample directory listing:\r\n");
        uart_puts("  <DIR>     BIN         \r\n");
        uart_puts("  <DIR>     ETC         \r\n");
        uart_puts("            CONFIG.SYS    256 bytes\r\n");
        uart_puts("\r\n");
        return;
    }

    vfs_dirent_t dirent;
    while (vfs_readdir(dfd, &dirent) == 0) {
        uart_puts("            ");
        uart_puts(dirent.name);
        uart_puts("\r\n");
    }

    vfs_closedir(dfd);
    uart_puts("\r\n");
}

static void cmd_type(int argc, char **argv)
{
    if (argc < 2) {
        uart_puts("\r\nUsage: TYPE filename\r\n");
        return;
    }

    uart_puts("\r\n");

    int fd = vfs_open(argv[1], O_RDONLY);
    if (fd < 0) {
        uart_puts("File not found: ");
        uart_puts(argv[1]);
        uart_puts("\r\n");
        return;
    }

    char buffer[512];
    int bytes_read;

    while ((bytes_read = vfs_read(fd, buffer, sizeof(buffer) - 1)) > 0) {
        buffer[bytes_read] = '\0';
        uart_puts(buffer);
    }

    uart_puts("\r\n");
    vfs_close(fd);
}

static void cmd_echo(int argc, char **argv)
{
    uart_puts("\r\n");
    for (int i = 1; i < argc; i++) {
        if (i > 1)
            uart_putc(' ');
        uart_puts(argv[i]);
    }
    uart_puts("\r\n");
}

static void cmd_cls(void)
{
    uart_puts("\x1B[2J\x1B[H");
}

static void cmd_mem(void)
{
    uart_puts("\r\n");
    uart_puts("Memory Information:\r\n");
    uart_puts("  Heap start: ");
    uart_puthex(HEAP_START);
    uart_puts("\r\n");
    uart_puts("  Heap size:  ");
    uart_puthex(HEAP_SIZE);
    uart_puts(" (8 MB)\r\n");
    uart_puts("  Status:     Active\r\n");
    uart_puts("\r\n");
}

static void cmd_ifs(void)
{
    uart_puts("\r\n");
    uart_puts("Loaded IFS drivers:\r\n");
    uart_puts("\r\n");
    ifs_list_drivers();
    uart_puts("\r\n");
}

/* ── Command dispatcher ──────────────────────────────────────────────────── */

static void execute_command(char *cmdline)
{
    char *argv[16];
    int argc = str_tokenize(cmdline, argv, 16);

    if (argc == 0)
        return;

    str_toupper(argv[0]);

    if (my_strcmp(argv[0], "VER") == 0) {
        cmd_ver();
    }
    else if (my_strcmp(argv[0], "HELP") == 0 || my_strcmp(argv[0], "?") == 0) {
        cmd_help();
    }
    else if (my_strcmp(argv[0], "DIR") == 0) {
        cmd_dir(argc, argv);
    }
    else if (my_strcmp(argv[0], "TYPE") == 0) {
        cmd_type(argc, argv);
    }
    else if (my_strcmp(argv[0], "ECHO") == 0) {
        cmd_echo(argc, argv);
    }
    else if (my_strcmp(argv[0], "CLS") == 0) {
        cmd_cls();
    }
    else if (my_strcmp(argv[0], "MEM") == 0) {
        cmd_mem();
    }
    else if (my_strcmp(argv[0], "IFS") == 0) {
        cmd_ifs();
    }
    else if (my_strcmp(argv[0], "BASIC") == 0) {
        cmd_basic();
    }
    else if (my_strcmp(argv[0], "EXIT") == 0) {
        uart_puts("\r\n[KERNEL] Exiting to idle loop...\r\n\r\n");
        while (1) {
            __asm__ volatile("wfi");
        }
    }
    else {
        uart_puts("\r\nBad command or file name: ");
        uart_puts(argv[0]);
        uart_puts("\r\nType HELP for list of commands\r\n");
    }
}

/* ── Kernel shell ────────────────────────────────────────────────────────── */

static void print_banner(void)
{
    uart_puts("\r\n");
    uart_puts("  ___  ____    ______     _  _  __              \r\n");
    uart_puts(" / _ \\/ ___|  / /___ \\   | || |/ /___ _  __    \r\n");
    uart_puts("| | | \\___ \\ / /  __) |  | || '_// _ \\ \\/ /   \r\n");
    uart_puts("| |_| |___) / /  / __/   |__   _|  __/>  <    \r\n");
    uart_puts(" \\___/|____/_/  |_____|     |_|  \\___/_/\\_\\  \r\n");
    uart_puts("\r\n");
    uart_puts("  OS/2 Warp 4.52  -  ARM64 Bare-Metal Kernel\r\n");
    uart_puts("  Target : QEMU virt  |  CPU : Cortex-A72\r\n");
    uart_puts("  UART   : PL011 @ ");
    uart_puthex(0x09000000UL);
    uart_puts("\r\n\r\n");
}

static void kernel_shell(void)
{
    char buffer[256];
    int pos = 0;

    uart_puts("\r\n");
    uart_puts("OS/2 Command Prompt\r\n");
    uart_puts("Type HELP for available commands\r\n");
    uart_puts("Type IFS to list loaded filesystem drivers\r\n");
    uart_puts("Type BASIC to start BASIC interpreter\r\n");
    uart_puts("\r\n");
    uart_puts("[C:\\]> ");

    while (1) {
        char c = uart_getc();

        if (c == '\r' || c == '\n') {
            uart_puts("\r\n");

            if (pos > 0) {
                buffer[pos] = '\0';
                execute_command(buffer);
                pos = 0;
            }

            uart_puts("[C:\\]> ");
        }
        else if (c == 0x7F || c == 0x08) {
            if (pos > 0) {
                pos--;
                uart_putc('\b');
                uart_putc(' ');
                uart_putc('\b');
            }
        }
        else if (c == 0x03) {
            uart_puts("^C\r\n[C:\\]> ");
            pos = 0;
        }
        else if (c >= 32 && c < 127) {
            if (pos < 255) {
                buffer[pos++] = c;
                uart_putc(c);
            }
        }
    }
}

/* ── Kernel entry point ──────────────────────────────────────────────────── */

void kernel_main(void)
{
    print_banner();

    uart_puts("[KERNEL] Subsystems initializing...\r\n");

    mem_init(HEAP_START, HEAP_SIZE);
    uart_puts("[MEM]    Allocator    : initialized\r\n");

    scheduler_init();
    uart_puts("[SCHED]  Scheduler    : initialized\r\n");

    uart_puts("[IPC]    Semaphores   : stub\r\n");

    uart_puts("[VFS]    Initializing VFS and filesystem drivers...\r\n");
    vfs_init();

    uart_puts("[BLK]    Initializing block devices...\r\n");
    blk_init();

    /* ── IFS Loader Integration ─────────────────────────────────────────── */
    uart_puts("[IFS]    Initializing IFS loader...\r\n");
    ifs_loader_init();

    /* Register built-in filesystem drivers */
    uart_puts("[IFS]    Registering ext4 driver...\r\n");
    if (ifs_register_builtin("EXT4", ext4_init, ext4_get_fs()) == 0) {
        uart_puts("[IFS]    ext4 driver registered successfully\r\n");
    } else {
        uart_puts("[IFS]    ERROR: Failed to register ext4 driver\r\n");
    }

    /* TODO: Load CONFIG.SYS from ramdisk or boot partition */
    /* For now, manually initialize ext4 with default parameters */
    uart_puts("[IFS]    Loading drivers with default parameters...\r\n");
    ext4_init("/CACHE:1024");

    uart_puts("\r\n[KERNEL] Boot complete.\r\n");
    uart_puts("[VFS]    Filesystem ready for mounting\r\n");
    uart_puts("[IFS]    Type 'IFS' command to list loaded drivers\r\n");
    uart_puts("\r\n");

    kbd_init();

    kernel_shell();
}