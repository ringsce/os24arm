# ============================================================================
# kernel/CMakeLists.txt - OS/2 Warp Kernel Build
# ============================================================================

# ── Kernel Executable ─────────────────────────────────────────────────────────

add_executable(os2warp_kernel
        ${CMAKE_SOURCE_DIR}/bootloader/start.S
        src/main.c
        src/doscalls.c
        src/keyboard.c
        src/uart.c
        src/kio.c
        src/blkdev.c
        src/vfs.c
        src/console.c
        src/cli_stubs.c
)

target_include_directories(os2warp_kernel PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}/include
        rexx
        os2api
)

target_link_options(os2warp_kernel PRIVATE
        -T ${CMAKE_CURRENT_SOURCE_DIR}/linker.ld
        -nostdlib
)

# ── Command Executables ───────────────────────────────────────────────────────

if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/commands/CMakeLists.txt)
    add_subdirectory(commands)
endif()

# ══════════════════════════════════════════════════════════════════════════════

message(STATUS "Kernel: os2warp_kernel (with cli_stubs.c)")
